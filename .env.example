# Neon Postgres connection string (Vercel Storage 탭에서 Neon 연결 후 발급, 또는 `vercel env pull .env.local`)
DATABASE_URL=

# Auth.js 세션 서명용 시크릿. `npx auth secret` 또는 `openssl rand -base64 32`로 생성
AUTH_SECRET=

# Contact 폼 발신용 Gmail 계정 (앱 비밀번호 필요: https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Contact 폼 메시지를 받을 이메일 주소 (보통 GMAIL_USER와 동일)
CONTACT_TO_EMAIL=
